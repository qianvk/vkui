# SPDX-License-Identifier: MIT

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.6 REQUIRED COMPONENTS Core Gui Svg)

include("${CMAKE_CURRENT_LIST_DIR}/VkUICoreTargets.cmake")
set(VkUI_Core_FOUND TRUE)

if("Buffer" IN_LIST VkUI_FIND_COMPONENTS
   OR "Interaction" IN_LIST VkUI_FIND_COMPONENTS
   OR "Panel" IN_LIST VkUI_FIND_COMPONENTS
   OR "InteractionWidgets" IN_LIST VkUI_FIND_COMPONENTS)
    if(@VKUI_BUILD_INTERACTION@)
        # The interaction export is atomic and contains its QWidget adapter,
        # so define the transitive Widgets target before loading that export.
        if(NOT TARGET VkUI::Widgets)
            find_dependency(Qt6 6.6 REQUIRED COMPONENTS Widgets)
            include("${CMAKE_CURRENT_LIST_DIR}/VkUIWidgetsTargets.cmake")
            set(VkUI_Widgets_FOUND TRUE)
        endif()
        if(APPLE AND NOT ICU_ROOT)
            foreach(_vkui_icu_root
                    IN ITEMS /opt/homebrew/opt/icu4c /usr/local/opt/icu4c)
                if(EXISTS "${_vkui_icu_root}/include/unicode/utf16.h")
                    set(ICU_ROOT "${_vkui_icu_root}")
                    break()
                endif()
            endforeach()
        endif()
        find_dependency(ICU 70 REQUIRED COMPONENTS uc i18n)
        include("${CMAKE_CURRENT_LIST_DIR}/VkUIInteractionTargets.cmake")
        set(VkUI_Buffer_FOUND TRUE)
        set(VkUI_Interaction_FOUND TRUE)
        set(VkUI_Panel_FOUND TRUE)
        set(VkUI_InteractionWidgets_FOUND TRUE)
    else()
        set(VkUI_NOT_FOUND_MESSAGE
            "This VkUI package was built without interaction components.")
    endif()
endif()

if((NOT VkUI_FIND_COMPONENTS OR "Widgets" IN_LIST VkUI_FIND_COMPONENTS)
   AND NOT TARGET VkUI::Widgets)
    find_dependency(Qt6 6.6 REQUIRED COMPONENTS Widgets)
    include("${CMAKE_CURRENT_LIST_DIR}/VkUIWidgetsTargets.cmake")
    set(VkUI_Widgets_FOUND TRUE)
endif()

if("Window" IN_LIST VkUI_FIND_COMPONENTS)
    if(@VKUI_BUILD_WINDOW@)
        find_dependency(Qt6 6.6 REQUIRED COMPONENTS Core Gui Widgets)
        include("${CMAKE_CURRENT_LIST_DIR}/VkUIWindowTargets.cmake")
        set(VkUI_Window_FOUND TRUE)
    else()
        set(VkUI_Window_FOUND FALSE)
        set(VkUI_NOT_FOUND_MESSAGE
            "This VkUI package was built without the Window component.")
    endif()
endif()

check_required_components(VkUI)
